// ============================================================================
// bc-shop REACTIVE-PERSISTENT DISPATCHER, as a fabro DOT workflow
// (ADR-058 AMENDED, lead-b3f0). ONE persistent NATIVE cyclic poll-loop per
// container: it OWNS the container's lifecycle, discovers work_ids at RUNTIME,
// and fans out one DETACHED child per pending inbox work item. Entered through
// the dispatcher.toml entrypoint (provider=local, in-process) so the sandbox
// comes up without a docker daemon (scenario A @scenario_hash:24d94274b9cbc2b0).
//
// ============================= NATIVE POLL-LOOP SHAPE (scenario B) ===========
//   start -> poll                                (enter the loop)
//   poll -> dispatch                             (act on the pending work ids)
//   poll -> end   [condition=outcome=failed]     (poll failed => shutdown sink)
//   dispatch -> wait                             (do not block on children)
//   wait -> poll                                 (the BACK-EDGE forms the cycle)
// The run persists -- cycling poll->dispatch->wait->poll -- until shutdown.
// EVERY loop node (poll, dispatch, wait) is a NATIVE `script=` node
// (parallelogram, NO LLM). There is NO long-running `shop-msg watch` node and
// NO LLM/agent node (no Haiku `launch` node, no model-backed node) ANYWHERE in
// the loop, so the steady-state loop spends ZERO tokens: work is done only by
// each child (scenario B @scenario_hash:a5e16a192f755768).
//
// ============================= POLL (NATIVE script=, NO LLM) =================
// `poll` lists the current pending inbox NON-BLOCKINGLY via `shop-msg pending
// inbox --bc $BC_NAME` (the no-matching-outbox, consumption-robust source) and
// yields the concrete pending work ids, returning PROMPTLY rather than blocking
// on a long-running watch. $BC_NAME arrives via the [run.environment.env]
// overlay (dispatcher.toml). A native node has EXACTLY two outcomes: exit 0 =>
// succeeded (poll->dispatch), nonzero => failed (poll->end shutdown).
//
// ============================= DISPATCH (NATIVE script=, NO LLM, scenario C) =
// `dispatch` acts on the pending work ids. Scenario C
// (@scenario_hash:6088da7e9e4c4e59) pins its per-child delivery contract: for
// each pending work id W it materializes a per-child `.toml` carrying the
// CONCRETE work id in a [run.environment.env] WORK_ID overlay and spawns the
// child DETACHED via `fabro run child.toml --detach` (NOT `-I WORK_ID`).
//
// ============================= CHILD DEF UNCHANGED (ADR-051 intact) ==========
// Each spawned child is the UNCHANGED ADR-051 workflow.fabro def running as a
// distinct run isolated by its own per-run WORK_ID: one child = one work item =
// one work_done. Children run in PARALLEL with no shared work-id file.
digraph BcShopDispatcher {
    graph [
        goal="Reactive-persistent NATIVE poll-loop dispatcher for BC {{ inputs.BC_NAME }}: poll the inbox non-blockingly, dispatch one DETACHED workflow.fabro child per pending work item (isolated per WORK_ID via a per-child env overlay), wait a short interval, and loop. NATIVE script= nodes only -- NO LLM and NO long-running watch, so the steady-state loop spends ZERO tokens; work is done only by each child. This run OWNS the container lifecycle and discovers work_ids at runtime; it takes NO launch-time work id."
        rankdir=TB
    ]

    // ---------- terminals ---------------------------------------------------
    start [shape=Mdiamond, label="Start"]
    end   [shape=Msquare,  label="Exit: SHUTDOWN\n(poll failed)"]

    // ---------- poll: NATIVE non-blocking pending-inbox lister (NO LLM) ------
    // $BC_NAME arrives via the [run.environment.env] overlay (dispatcher.toml).
    // Lists the current pending inbox and yields the concrete pending work ids,
    // returning PROMPTLY (NOT blocking on a long-running `shop-msg watch`).
    poll [shape=parallelogram, deterministic=true,
          label="poll: list pending inbox work ids (non-blocking)",
          script="shop-msg pending inbox --bc \"$BC_NAME\""]

    // ---------- dispatch: NATIVE, acts on the pending work ids (NO LLM) ------
    // Scenario C elaborates the per-child .toml env-overlay fan-out here.
    dispatch [shape=parallelogram, deterministic=true,
              label="dispatch: act on each pending work id",
              script="shop-msg pending inbox --bc \"$BC_NAME\" | awk '{print $1}' | while read -r wid; do [ -n \"$wid\" ] || continue; echo \"dispatch $wid\"; done"]

    // ---------- wait: NATIVE short sleep before the back-edge (NO LLM) -------
    wait [shape=parallelogram, deterministic=true,
          label="wait: sleep a short interval before looping",
          script="sleep \"${DISPATCH_POLL_INTERVAL:-5}\""]

    // ---------- edges (native cyclic poll-loop, scenario B) -----------------
    start    -> poll                                    // enter the loop
    poll     -> dispatch                                // act on pending work ids
    poll     -> end       [condition="outcome=failed"]  // poll failed => shutdown
    dispatch -> wait                                    // do not block on children
    wait     -> poll                                    // BACK-EDGE forms the cycle
}
